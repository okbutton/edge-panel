{
  "name": "Chrome",
  "icon": "",
  "match": {
    "app": "^(google-chrome|chromium)$"
  },
  "pages": [
    {
      "name": "Browse",
      "actions": [
        {
          "icon": "",
          "label": "Back",
          "keys": "alt+Left"
        },
        {
          "icon": "",
          "label": "Forward",
          "keys": "alt+Right"
        },
        {
          "icon": "",
          "label": "Reload",
          "keys": "ctrl+r"
        },
        {
          "icon": "",
          "label": "Address bar",
          "keys": "ctrl+l"
        },
        {
          "icon": "",
          "label": "Find",
          "keys": "ctrl+f"
        },
        {
          "icon": "",
          "label": "Bookmark",
          "keys": "ctrl+d"
        }
      ]
    },
    {
      "name": "Tabs",
      "actions": [
        {
          "icon": "",
          "label": "Previous tab",
          "keys": "ctrl+shift+Tab"
        },
        {
          "icon": "",
          "label": "Next tab",
          "keys": "ctrl+Tab"
        },
        {
          "icon": "",
          "label": "New tab",
          "keys": "ctrl+t"
        },
        {
          "icon": "",
          "label": "Reopen tab",
          "keys": "ctrl+shift+t"
        },
        {
          "icon": "",
          "label": "Close tab",
          "keys": "ctrl+w",
          "danger": true
        }
      ]
    }
  ]
}
